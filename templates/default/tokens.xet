<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
	<template id="webauthn.tokens.rows" template="" lang="" group="0" version="1.9.001">
		<grid width="100%" height="100%">
			<columns>
				<column width="30"/>
				<column width="120"/>
				<column width="120"/>
				<column width="15%"/>
				<column width="120"/>
				<column width="120"/>
				<column width="120"/>
				<column width="50"/>
			</columns>
			<rows>
				<row>
					<nextmatch-sortheader label="ID" id="pubkey_id"/>
					<nextmatch-header label="Type" id="type"/>
					<nextmatch-header label="Attestation" id="attestationType"/>
					<nextmatch-sortheader label="Credential ID" id="pubkey_credential_id"/>
					<nextmatch-sortheader label="Created" id="pubkey_created"/>
					<nextmatch-sortheader label="Last modified" id="pubkey_updated"/>
					<nextmatch-sortheader label="Deleted" id="pubkey_deleted"/>
					<nextmatch-header label="Counter" id="counter"/>
				</row>
				<row class="$row_cont[status_class]">
					<et2-description  id="${row}[pubkey_id]" noLang="1"></et2-description>
					<et2-description  id="${row}[type]" noLang="1"></et2-description>
					<et2-description  id="${row}[attestationType]" noLang="1"></et2-description>
					<et2-description  id="${row}[pubkey_credential_id]" noLang="1"></et2-description>
					<et2-date-time  id="${row}[pubkey_created]" readonly="true"></et2-date-time>
					<et2-date-time  id="${row}[pubkey_updated]" readonly="true"></et2-date-time>
					<et2-date-time  id="${row}[pubkey_deleted]" readonly="true"></et2-date-time>
					<et2-description  id="${row}[counter]" noLang="1"></et2-description>
				</row>
			</rows>
		</grid>
	</template>
	<template id="webauthn.tokens.add" template="" lang="" group="0" version="1.7.001">
		<et2-button  label="Register" id="add" onclick="if (!app.webauthn) app.webauthn = new app.classes.webauthn(); app.webauthn.register(widget)" noSubmit="true"></et2-button>
	</template>
	<template id="webauthn.tokens" template="" lang="" group="0" version="1.9.001">
		<hidden id="registrationResponse" />
		<nextmatch id="webauthn" template="webauthn.tokens.rows" header_left="webauthn.tokens.add" />
	</template>
</overlay>
