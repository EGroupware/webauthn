<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2//EN" "http://www.egroupware.org/etemplate2.dtd">
<overlay>
	<template id="webauthn.tokens.rows" template="" lang="" group="0" version="1.9.001">
		<grid width="100%" height="100%">
			<columns>
				<column width="10"/>
				<column width="80%" />
				<column width="110"/>
			</columns>
			<rows>
				<row class="th">

				</row>
				<row class="$row_cont[status_class]">
					<description id="${row}[pubkey_id]" no_lang="1"/>
					<vbox>
						<description id="${row}[type]" no_lang="1"/>
						<description id="${row}[attestationType]" no_lang="1"/>
					</vbox>
					<description id="${row}[counter]" no_lang="1"/>
				</row>
			</rows>
		</grid>
	</template>
	<template id="webauthn.tokens.add" template="" lang="" group="0" version="1.7.001">

	</template>
	<template id="webauthn.tokens" template="" lang="" group="0" version="1.9.001">
		<hidden id="registrationResponse" />
		<nextmatch id="webauthn" template="webauthn.tokens.rows" header_left="webauthn.tokens.add" />
		<hbox>
			<buttononly label=" " id="add" onclick="if (!app.webauthn) app.webauthn = new app.classes.webauthn(); app.webauthn.register(widget)" class="plus_button"/>
		</hbox>
	</template>
</overlay>